<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
 <!-- ADR-032 / #365: Traeger override of the calendar policies (visibility scope, asker usernames). Null = no override, the platform preset applies. -->
 <changeSet id="tenant-permission-policy-calendar" author="oriso">
  <preConditions onFail="CONTINUE"><not><columnExists tableName="tenant_permission_policy" columnName="calendar_policies"/></not></preConditions>
  <addColumn tableName="tenant_permission_policy"><column name="calendar_policies" type="LONGTEXT"/></addColumn>
  <rollback><dropColumn tableName="tenant_permission_policy" columnName="calendar_policies"/></rollback>
 </changeSet>
</databaseChangeLog>
