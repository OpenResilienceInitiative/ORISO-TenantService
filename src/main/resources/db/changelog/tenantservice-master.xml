<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.2.xsd">

  <!--
    Single master changelog for ALL environments (Liquibase Re-Enablement Plan 2026-07-04, package L1).

    Replaces the former per-environment masters (local/dev/staging/prod/testing).
    Environment differences are expressed via Liquibase contexts, activated through
    spring.liquibase.contexts per Spring profile:
      - local/dev activate context "seed" (seed/demo data changesets, if any are added later)
      - staging/prod activate context "prod" (schema-only; changesets tagged context="seed" are skipped)
    Changesets without a context attribute run in every environment.

    IMPORTANT: changeset identity is (id, author, filepath). Never move or rename
    existing changeset files.
  -->

  <!-- The base changeset contains the database state when liquibase was added to the project -->
  <include file="db/changelog/changeset/0001_initsql/initSql.xml"/>
  <!-- 0002 was historically missing from the prod/staging masters although 0006 depends on the
       columns it adds; it carries a columnExists precondition (MARK_RAN) so it is safe on
       databases that already received the columns outside of Liquibase. -->
